# Copy to .env.local and fill what you want to use.

# --- LLM Providers ---
# Ollama (local) — default URL works if Ollama runs on the same machine
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic Claude
ANTHROPIC_API_KEY=

# OpenAI / ChatGPT (also used for Whisper transcription)
OPENAI_API_KEY=

# --- Supabase (optional for MVP, required for auth + persisted sessions) ---
# Without these, the app runs in single-user dev mode (no login required).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
